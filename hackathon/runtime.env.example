# Inject actual credentials with Secret Manager. Never commit a populated copy.
AISLEMINT_HACKATHON=1
POSTGRES_DATABASE=aislemint_hackathon
POSTGRES_USER=aibuildercup_app
POSTGRES_HOST=/cloudsql/YOUR_PROJECT:YOUR_REGION:YOUR_INSTANCE
POSTGRES_SSLMODE=disable
POSTGRES_POOL_SIZE=8
RETAIL_TRAINING_WORKER=external
CONNECTED_WORKER=inline
DATA_PLATFORM_WORKER=inline
LEGACY_TRAINING_WORKER=external
PUBLIC_ORIGIN=https://aibuildercup.aislemint.com
PUBLIC_ORIGINS=https://aibuildercup.aislemint.com
TRUSTED_HOSTS=aibuildercup.aislemint.com,localhost,127.0.0.1,*.run.app
